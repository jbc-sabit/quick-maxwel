# ---------------------------------------------------------------------------
# Database: any hosted PostgreSQL (e.g. Neon, Supabase, Railway). No local Docker needed.
# ---------------------------------------------------------------------------
# Used by the running app. A pooled connection string is fine (and recommended on Vercel).
# Add ?sslmode=require for hosted databases.
DATABASE_URL=
# Optional: a direct (non-pooled) connection used for migrations. Falls back to DATABASE_URL.
# Neon's Vercel integration sets this automatically.
# DATABASE_URL_UNPOOLED=

# ---------------------------------------------------------------------------
# Auth: required in production (min 32 characters). Generate with: openssl rand -base64 48
# ---------------------------------------------------------------------------
JWT_SECRET=

# ---------------------------------------------------------------------------
# S3-compatible object storage for file uploads (avatars, covers, certificates, CV)
# ---------------------------------------------------------------------------
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
# Optional: bucket name (default "media") and public base URL for served files
# (defaults to <AWS_ENDPOINT_URL_S3>/<S3_BUCKET>; set this if you front the bucket with a CDN)
S3_BUCKET=
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# Demo portfolios (public showcase accounts, see src/lib/demo-account.ts)
# ---------------------------------------------------------------------------
# One shared password for all demo accounts (random in production if unset).
# Applied when they are created; change it later with: pnpm db:seed --passwords-only
# DEMO_USER_PASSWORD=
# "true" lets people sign into the demo accounts in production (default: refused).
# ALLOW_DEMO_LOGIN=

# ---------------------------------------------------------------------------
# Deployment (Vercel build runs `pnpm vercel-build`: migrate, add demos, next build)
# ---------------------------------------------------------------------------
# SKIP_DB_SETUP=true        build without touching a database
# SKIP_DEMO_SEED=true       run migrations but don't add the demo portfolios
# DB_SETUP_ON_PREVIEW=true  also migrate/seed on Vercel Preview deployments (skipped by default)

# ---------------------------------------------------------------------------
# Public app URL. Also drives subdomain portfolios: <handle>.<host of this URL> serves
# the same page as <this URL>/<handle>. Needs a wildcard DNS record (*.example.com) and
# a wildcard domain in Vercel. <handle>.localhost works in local dev regardless.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL=https://example.com
